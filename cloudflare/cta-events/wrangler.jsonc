{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "touseefshaik-cta-events",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "touseefshaik.com/api/events*",
      "zone_name": "touseefshaik.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "touseefshaik-site-events",
      "database_id": "27e4fd77-5383-4bb7-88d4-27995ebcf336"
    }
  ]
}
